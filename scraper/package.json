{
  "name": "cruise-monitor-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Scheduled scraper that checks tracked cruise fares against each cruise line's public pricing and writes snapshots/alerts to Firestore.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
