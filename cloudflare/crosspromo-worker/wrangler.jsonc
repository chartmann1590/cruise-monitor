{
  "name": "cruisewatch-crosspromo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PLAY_STORE_BASE_URL": "https://play.google.com",
    "DEVELOPER_ID": "Hartmann Studios",
    "SDK_VERSION": "1.0.0",
    "CATALOG_CACHE_TTL_SECONDS": "1800",
    "RECOMMENDATION_CACHE_TTL_SECONDS": "3600"
  },
  "kv_namespaces": [
    {
      "binding": "CROSS_PROMO_KV",
      "id": "8d345818bef1409884e814bef12a7d7b"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cruisewatch-crosspromo",
      "database_id": "01ffedaa-363c-4e58-9a6c-1acc98262299"
    }
  ],
   "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
