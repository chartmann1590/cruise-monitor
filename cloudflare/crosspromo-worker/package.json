{
  "name": "cruisewatch-crosspromo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:remote": "wrangler d1 migrations apply cruisewatch-crosspromo --remote",
    "migrate:local": "wrangler d1 migrations apply cruisewatch-crosspromo --local",
    "refresh:cron": "wrangler deploy --retry"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.10",
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.31.0"
  }
}
