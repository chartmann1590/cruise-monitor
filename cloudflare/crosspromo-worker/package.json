{
  "name": "cruisewatch-crosspromo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:remote": "wrangler d1 migrations apply cruisewatch-crosspromo --remote",
    "migrate:local": "wrangler d1 migrations apply cruisewatch-crosspromo --local",
    "refresh:cron": "wrangler deploy --retry"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
